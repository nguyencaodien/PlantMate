<?xml version="1.0" encoding="utf-8"?>
<!-- Listing card (canvas B "Tin mới quanh bạn"): photo with the type tag top-left and a save heart top-right,
     then the name, the offer line (green "Free", "For …" or the price), a status pill for sales, and the owner
     with distance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="20dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/listing_card_frame"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_panel_16">

        <ImageView
            android:id="@+id/listing_card_cover"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:contentDescription="@string/listing_cover_photo"
            android:src="@drawable/ic_botanical_placeholder" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/listing_card_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/listing_cover_photo"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame16" />

        <TextView
            android:id="@+id/listing_card_offer"
            style="@style/Widget.PlantMate.Tag"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:textSize="12sp" />

        <!-- contentDescription names the listing; ListingAdapter sets it. -->
        <ImageButton
            android:id="@+id/listing_card_save"
            tools:ignore="ContentDescription"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_photo_round_button"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bookmark"
            android:stateListAnimator="@animator/pm_press"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/listing_card_nickname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/listing_card_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Sale listings only: Available / Reserved / Sold (ListingAdapter.bindSaleStatus). -->
    <TextView
        android:id="@+id/listing_card_status"
        style="@style/Widget.PlantMate.SaleStatus"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/listing_card_owner_avatar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_avatar_neutral"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/color_text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/listing_card_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
