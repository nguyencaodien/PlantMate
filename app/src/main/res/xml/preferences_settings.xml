<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:layout="@layout/item_preference_category" app:title="@string/settings_general_category">
        <Preference app:key="app_language"
            app:icon="@drawable/ic_language"
            app:layout="@layout/item_preference_single"
            app:title="@string/settings_language"
            app:persistent="false" />
    </PreferenceCategory>
    <PreferenceCategory app:layout="@layout/item_preference_category" app:title="@string/settings_notifications_category">
        <SwitchPreferenceCompat app:key="care_notifications_enabled_ui"
            app:icon="@drawable/ic_water_drop"
            app:layout="@layout/item_preference_top"
            app:widgetLayout="@layout/item_preference_switch"
            app:title="@string/settings_care_notifications"
            app:summary="@string/settings_care_notifications_summary" />
        <Preference app:key="notification_settings_action"
            app:icon="@drawable/ic_bell"
            app:layout="@layout/item_preference_bottom"
            app:title="@string/settings_system_notifications"
            app:summary="@string/settings_system_notifications_summary" />
    </PreferenceCategory>
    <PreferenceCategory app:layout="@layout/item_preference_category" app:title="@string/settings_safety_category">
        <Preference app:key="blocked_users_action"
            app:icon="@drawable/ic_lock"
            app:layout="@layout/item_preference_single"
            app:title="@string/blocked_users_title"
            app:summary="@string/blocked_users_summary" app:persistent="false" />
    </PreferenceCategory>
    <PreferenceCategory app:layout="@layout/item_preference_category" app:title="@string/settings_account_category">
        <Preference app:key="delete_account_action"
            app:icon="@drawable/ic_trash"
            app:layout="@layout/item_preference_single"
            app:title="@string/delete_account_title"
            app:summary="@string/settings_delete_account_summary" app:persistent="false" />
    </PreferenceCategory>
    <PreferenceCategory app:key="admin_category" app:isPreferenceVisible="false"
        app:layout="@layout/item_preference_category" app:title="@string/settings_admin_category">
        <Preference app:key="admin_tools_action"
            app:icon="@drawable/ic_lock"
            app:layout="@layout/item_preference_single"
            app:title="@string/settings_admin_tools"
            app:summary="@string/settings_admin_tools_summary"
            app:persistent="false" />
    </PreferenceCategory>
    <PreferenceCategory app:layout="@layout/item_preference_category" app:title="@string/settings_about_category">
        <Preference app:key="app_version_info"
            app:icon="@drawable/ic_leaf"
            app:layout="@layout/item_preference_top"
            app:title="@string/settings_app_version"
            app:selectable="false" />
        <Preference app:key="about_plantmate"
            app:icon="@drawable/ic_sparkle"
            app:layout="@layout/item_preference_bottom"
            app:title="@string/settings_about_plantmate"
            app:summary="@string/settings_about_open"
            app:persistent="false" />
    </PreferenceCategory>
</PreferenceScreen>
