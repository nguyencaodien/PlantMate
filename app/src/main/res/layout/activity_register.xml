<?xml version="1.0" encoding="utf-8"?>
<!-- Register (sign-in style): back, the heading beside Mầm, four labelled fields on the page,
     pill button, Google / Facebook side by side, then sign in. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/register_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_register_back"
                style="@style/Widget.PlantMate.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:contentDescription="@string/action_back"
                app:backgroundTint="@color/color_surface"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_arrow_back" />

        </FrameLayout>

        <!-- Heading beside Mầm -->
        <FrameLayout
            android:id="@+id/register_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="88dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:letterSpacing="-0.02"
                    android:text="@string/register_heading"
                    android:textAppearance="@style/TextAppearance.PlantMate.ScreenTitle"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/register_supporting_text"
                    android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/register_mam"
                android:layout_width="78dp"
                android:layout_height="111dp"
                android:layout_gravity="center_vertical|end"
                android:contentDescription="@null"
                android:src="@drawable/avd_mam" />
        </FrameLayout>

        <!-- Form card -->
        <LinearLayout
            android:id="@+id/register_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/register_display_name_input"
                android:text="@string/register_label_full_name"
                android:textAppearance="@style/TextAppearance.PlantMate.Label"
                android:textColor="@color/color_text_primary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/register_display_name_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_nav_profile"
                app:startIconTint="@color/color_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/register_display_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:autofillHints="name"
                    android:hint="@string/register_hint_full_name"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/register_email_input"
                android:text="@string/label_email"
                android:textAppearance="@style/TextAppearance.PlantMate.Label"
                android:textColor="@color/color_text_primary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/register_email_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_mail"
                app:startIconTint="@color/color_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/register_email_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:autofillHints="emailAddress"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/register_password_input"
                android:text="@string/label_password"
                android:textAppearance="@style/TextAppearance.PlantMate.Label"
                android:textColor="@color/color_text_primary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/register_password_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:endIconMode="password_toggle"
                app:helperText="@string/register_password_helper"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/color_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/register_password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:autofillHints="newPassword"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:labelFor="@id/register_location_input"
                android:text="@string/register_label_location"
                android:textAppearance="@style/TextAppearance.PlantMate.Label"
                android:textColor="@color/color_text_primary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/register_location_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_location"
                app:startIconTint="@color/color_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/register_location_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:hint="@string/register_hint_location"
                    android:inputType="textPostalAddress|textCapWords"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_create_account"
                style="@style/Widget.PlantMate.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_create_account"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                app:iconTint="@color/color_primary_button_icon" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_register_google"
                    style="@style/Widget.PlantMate.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/sign_in_google_short"
                    android:textColor="@color/color_text_primary"
                    android:textSize="15sp"
                    app:backgroundTint="@color/color_surface"
                    app:icon="@drawable/ic_google_logo"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="20dp"
                    app:iconTint="@null"
                    app:strokeColor="@color/color_input_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_continue_facebook"
                    style="@style/Widget.PlantMate.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/sign_in_facebook_short"
                    android:textColor="@color/color_text_primary"
                    android:textSize="15sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/color_surface"
                    app:icon="@drawable/ic_facebook_logo"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="20dp"
                    app:iconTint="@null"
                    app:strokeColor="@color/color_input_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prompt_existing_account"
                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/action_sign_in_existing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/action_sign_in_existing"
                android:textAppearance="@style/TextAppearance.PlantMate.Label"
                android:textColor="@color/color_primary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
