<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/mam_step_number"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_mint_circle"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.PlantMate.Label"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/mam_step_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.PlantMate.Body"
        android:textSize="14sp" />
</LinearLayout>
