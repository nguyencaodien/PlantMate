<?xml version="1.0" encoding="utf-8"?>
<!-- Notifications (bell canvas, option A): title with "Read all", All / Care / Community filter,
     rows grouped Today / Earlier; loading, empty and error states. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notifications_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/notifications_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notifications_back"
            style="@style/Widget.PlantMate.IconButton.Hero"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/notifications_title"
            android:textAppearance="@style/TextAppearance.PlantMate.ScreenTitle"
            android:textSize="22sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notifications_read_all"
            style="@style/Widget.PlantMate.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/notifications_read_all"
            android:textColor="@color/color_success" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/notifications_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/notifications_filter_all"
            style="@style/PlantMateFilterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/notifications_filter_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/notifications_filter_care"
            style="@style/PlantMateFilterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notifications_filter_care" />

        <com.google.android.material.chip.Chip
            android:id="@+id/notifications_filter_community"
            style="@style/PlantMateFilterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notifications_filter_community" />
    </com.google.android.material.chip.ChipGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/notifications_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp" />

        <ProgressBar
            android:id="@+id/notifications_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/color_primary" />

        <TextView
            android:id="@+id/notifications_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/notifications_empty"
            android:textAppearance="@style/TextAppearance.PlantMate.Body"
            android:textColor="@color/color_text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/notifications_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/notifications_error"
                android:textAppearance="@style/TextAppearance.PlantMate.Body"
                android:textColor="@color/color_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/notifications_retry"
                style="@style/Widget.PlantMate.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/action_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
