<?xml version="1.0" encoding="utf-8"?>
<!-- Activity log row (Leafy style): soft icon disc per care type, the care type with how long
     ago, an optional note, and the time on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:id="@+id/careLogIconTile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_mint_circle">

        <ImageView
            android:id="@+id/careLogIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_water_drop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/careLogType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PlantMate.Label"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/careLogDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/careLogNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.PlantMate.Body"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/careLogTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="@style/TextAppearance.PlantMate.Meta"
        android:textSize="13sp" />
</LinearLayout>
