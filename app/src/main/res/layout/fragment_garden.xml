<?xml version="1.0" encoding="utf-8"?>
<!-- Garden (canvas B "Vườn của tôi"): month with search and calendar, title and counts, the week strip with a
     sliding ink pill, the day's care panel (progress, rows grouped by time, liquid-fill water buttons), Mầm's tip
     from the care log, "My plants" with area chips over a two-column grid, and recent activity. Everything
     comes from the member's Room garden; no care tasks are invented. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/gardenScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/fab_bottom_clearance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Search -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gardenSearchToggle"
                    style="@style/Widget.PlantMate.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/garden_search_desc"
                    app:icon="@drawable/ic_search"
                    app:iconSize="24dp"
                    app:strokeWidth="0dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gardenHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/garden_title"
                        android:textAppearance="@style/TextAppearance.PlantMate.Hero"
                        android:textSize="30sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/gardenAdd"
                        style="@style/Widget.PlantMate.Button.Header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/garden_fab_add" />
                </LinearLayout>

                <TextView
                    android:id="@+id/gardenSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/garden_subtitle"
                    android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Search within the garden (opened by the search button) -->
            <LinearLayout
                android:id="@+id/gardenSearchBar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_search_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/color_text_secondary" />

                <EditText
                    android:id="@+id/gardenSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/garden_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body"
                    android:textColorHint="@color/color_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gardenContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Week (canvas option J): the selected day as a big date, then the week as dots; tap the date for today -->
                <LinearLayout
                    android:id="@+id/gardenWeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_hairlines_top_bottom"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:id="@+id/gardenBigDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/garden_calendar_desc"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/gardenBigDay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.04"
                            android:textAppearance="@style/TextAppearance.PlantMate.Hero"
                            android:textSize="48sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/gardenBigWeekday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/gardenBigMonth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/gardenWeekDays"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- The day's care -->
                <LinearLayout
                    android:id="@+id/gardenTasksCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="20dp"
                    android:animateLayoutChanges="true"
                    android:background="@drawable/bg_panel_20"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/gardenTodayTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/gardenTodayCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/gardenTodayProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:importantForAccessibility="no"
                        android:max="100"
                        app:indicatorColor="@color/color_primary"
                        app:trackColor="@color/color_panel_line"
                        app:trackCornerRadius="3dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="6dp" />

                    <LinearLayout
                        android:id="@+id/gardenTaskList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <!-- A day with nothing to do -->
                    <LinearLayout
                        android:id="@+id/gardenTasksDone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="18dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_leaf"
                            app:tint="@color/color_primary" />

                        <TextView
                            android:id="@+id/gardenTasksDoneTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/garden_day_free_title"
                            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/garden_day_free_body"
                            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/gardenTasksMore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Mầm's tip from the care log -->
                <LinearLayout
                    android:id="@+id/gardenTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_tint_panel_16"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/gardenMam"
                        android:layout_width="28dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mam" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/gardenTipTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PlantMate.Label"
                            android:textColor="@color/color_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/garden_tip_early_body"
                            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/gardenTipAction"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:text="@string/garden_tip_action"
                            android:textAppearance="@style/TextAppearance.PlantMate.Label"
                            android:textColor="@color/color_text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- My plants -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/garden_mine_title"
                        android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/gardenSort"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textAppearance="@style/TextAppearance.PlantMate.Label"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/gardenZones"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gardenShelf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <!-- Recent activity -->
            <LinearLayout
                android:id="@+id/gardenActivitySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/PlantMateSectionHeading"
                    android:layout_marginTop="24dp"
                    android:text="@string/garden_activity_title" />

                <LinearLayout
                    android:id="@+id/gardenActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/gardenLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="60dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/color_primary"
                    app:trackColor="@color/color_primary_tint" />

                <LinearLayout
                    android:id="@+id/gardenEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="120dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mam" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/garden_empty_title"
                        android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="center"
                        android:text="@string/garden_empty_supporting"
                        android:textAppearance="@style/TextAppearance.PlantMate.Meta" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/gardenEmptyAction"
                        style="@style/Widget.PlantMate.Button.Green.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/garden_add_plant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/gardenError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="@dimen/spacing_lg"
                    android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
