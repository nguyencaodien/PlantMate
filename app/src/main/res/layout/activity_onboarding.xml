<?xml version="1.0" encoding="utf-8"?>
<!-- First run, once per account (canvas B "Onboarding"): a thin progress bar with "Skip", one question per step
     (area chips and field · what you came for as check cards · a reminder preview), then back and "Continue". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- fitsSystemWindows replaces this view's padding with the bar insets, so the gutter sits one level in. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/onboarding_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                app:indicatorColor="@color/color_primary"
                app:trackColor="@color/color_panel_line"
                app:trackCornerRadius="3dp"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onboarding_skip"
                style="@style/Widget.PlantMate.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/onboarding_skip"
                android:textColor="@color/color_text_primary" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <!-- Step 1: area -->
                <LinearLayout
                    android:id="@+id/onboarding_step_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/PlantMateOnboardingTitle"
                        android:text="@string/onboarding_area_title" />

                    <TextView
                        style="@style/PlantMateOnboardingBody"
                        android:text="@string/onboarding_area_body" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/onboarding_area_chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp"
                        app:singleSelection="true" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/ic_location_small"
                        app:startIconTint="@color/color_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/onboarding_area"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/onboarding_area_hint"
                            android:importantForAutofill="no"
                            android:inputType="textPostalAddress|textCapWords"
                            android:maxLength="80"
                            android:maxLines="1"
                            android:minHeight="52dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/bg_tint_panel_16">

                        <ImageView
                            android:layout_width="112dp"
                            android:layout_height="160dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_mam" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/onboarding_area_later"
                        android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Step 2: what you came for -->
                <LinearLayout
                    android:id="@+id/onboarding_step_intents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/PlantMateOnboardingTitle"
                        android:text="@string/onboarding_intents_title" />

                    <TextView
                        style="@style/PlantMateOnboardingBody"
                        android:text="@string/onboarding_intents_body" />

                    <LinearLayout
                        android:id="@+id/onboarding_intents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Step 3: reminders, with what one looks like -->
                <LinearLayout
                    android:id="@+id/onboarding_step_reminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/PlantMateOnboardingTitle"
                        android:text="@string/onboarding_reminders_title" />

                    <TextView
                        style="@style/PlantMateOnboardingBody"
                        android:text="@string/onboarding_reminders_body" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_panel_20"
                        android:contentDescription="@string/onboarding_preview_desc"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_tint_panel_16"
                            android:importantForAccessibility="no">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_leaf"
                                app:tint="@color/color_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:importantForAccessibility="noHideDescendants"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/app_name"
                                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                                    android:textColor="@color/color_text_primary"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/onboarding_preview_time"
                                    android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/onboarding_preview_text"
                                android:textAppearance="@style/TextAppearance.PlantMate.Body"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onboarding_back"
                style="@style/Widget.PlantMate.Button.Outlined"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/action_back"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onboarding_next"
                style="@style/Widget.PlantMate.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/onboarding_next" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_later"
            style="@style/Widget.PlantMate.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_reminders_later"
            android:textColor="@color/color_text_primary"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />
    </LinearLayout>
</LinearLayout>
