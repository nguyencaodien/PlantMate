<?xml version="1.0" encoding="utf-8"?>
<!-- Profile (canvas B "Hồ sơ"): "Profile" with share and settings; the member (ink avatar, name, role and area
     tags), bio, joined and verified lines; ink "Edit profile" and green "My garden"; four numbers; the rank panel
     with progress and badges; the ink "still available?" card; listing tabs; the newest review; the account menu. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/profile_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/screen_profile_title"
                    android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                    android:textSize="17sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_share"
                    style="@style/Widget.PlantMate.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/profile_share"
                    app:icon="@drawable/ic_share"
                    app:iconSize="24dp"
                    app:strokeWidth="0dp" />

                <!-- Light/dark switch, remembered per account (Settings stays in the Account section). -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_theme_toggle"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <ImageView
                        android:id="@+id/profile_theme_light"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_theme_segment"
                        android:contentDescription="@string/theme_light"
                        android:padding="9dp"
                        android:src="@drawable/ic_sun"
                        app:tint="@color/theme_segment_icon" />

                    <ImageView
                        android:id="@+id/profile_theme_dark"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_theme_segment"
                        android:contentDescription="@string/theme_dark"
                        android:padding="9dp"
                        android:src="@drawable/ic_moon"
                        app:tint="@color/theme_segment_icon" />
                </LinearLayout>
            </LinearLayout>

            <!-- Email verification reminder (email/password accounts only) -->
            <LinearLayout
                android:id="@+id/profile_verify_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_panel_16"
                android:backgroundTint="@color/type_trade_soft"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mail"
                        app:tint="@color/type_trade_ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/verify_title"
                            android:textAppearance="@style/TextAppearance.PlantMate.Label"
                            android:textColor="@color/color_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/profile_verify_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:accessibilityLiveRegion="polite"
                            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                            android:textColor="@color/color_text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profile_verify_resend"
                        style="@style/Widget.PlantMate.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/verify_resend"
                        android:textColor="@color/type_trade_ink" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profile_verify_done"
                        style="@style/Widget.PlantMate.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/verify_done"
                        android:textColor="@color/type_trade_ink" />
                </LinearLayout>
            </LinearLayout>

            <!-- Member -->
            <LinearLayout
                android:id="@+id/profile_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/profile_avatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_avatar_ink"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                    android:textColor="@color/color_background"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_display_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:letterSpacing="-0.02"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.PlantMate.Hero"
                        android:textSize="26sp"
                        app:lineHeight="32sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="6dp">

                        <TextView
                            android:id="@+id/profile_role"
                            style="@style/Widget.PlantMate.Tag"
                            android:layout_height="wrap_content"
                            android:minHeight="24dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:background="@drawable/bg_tag_green"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:text="@string/profile_role_giver"
                            android:textColor="@color/color_on_primary"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/profile_location"
                            style="@style/Widget.PlantMate.Tag"
                            android:layout_height="wrap_content"
                            android:minHeight="24dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:background="@drawable/bg_tag_grey"
                            android:maxLines="1"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:textColor="@color/color_text_primary"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/profile_bio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textAppearance="@style/TextAppearance.PlantMate.Body"
                android:textSize="15sp"
                app:lineHeight="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/profile_joined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_calendar_14"
                    app:drawableTint="@color/color_text_secondary" />

                <TextView
                    android:id="@+id/profile_verified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:text="@string/profile_email_verified"
                    android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_mail_14"
                    app:drawableTint="@color/color_text_secondary" />
            </LinearLayout>

            <!-- Edit profile (ink) · My garden (green) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_edit"
                    style="@style/Widget.PlantMate.Button.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/profile_edit"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_garden"
                    style="@style/Widget.PlantMate.Button.Green.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/profile_my_garden"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_leaf"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp" />
            </LinearLayout>

            <!-- Four numbers -->
            <LinearLayout
                android:id="@+id/profile_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_panel_20"
                android:baselineAligned="false"
                android:divider="@drawable/divider_panel_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:showDividers="middle">

                <LinearLayout style="@style/PlantMateProfileStat">
                    <TextView android:id="@+id/profile_stat_listings" style="@style/PlantMateProfileStatValue" />
                    <TextView style="@style/PlantMateProfileStatLabel" android:text="@string/profile_stat_listings" />
                </LinearLayout>

                <LinearLayout style="@style/PlantMateProfileStat">
                    <TextView android:id="@+id/profile_stat_given" style="@style/PlantMateProfileStatValue" />
                    <TextView style="@style/PlantMateProfileStatLabel" android:text="@string/profile_stat_given" />
                </LinearLayout>

                <LinearLayout style="@style/PlantMateProfileStat">
                    <TextView android:id="@+id/profile_stat_swapped" style="@style/PlantMateProfileStatValue" />
                    <TextView style="@style/PlantMateProfileStatLabel" android:text="@string/profile_stat_swapped" />
                </LinearLayout>

                <LinearLayout style="@style/PlantMateProfileStat">
                    <TextView android:id="@+id/profile_stat_rating" style="@style/PlantMateProfileStatValue" />
                    <TextView style="@style/PlantMateProfileStatLabel" android:text="@string/profile_stat_rating" />
                </LinearLayout>
            </LinearLayout>

            <!-- Trust panel (trust canvas 1): score ring, verification checklist, then history. -->
            <LinearLayout
                android:id="@+id/profile_rank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_rank_panel_20"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/profile_rank_ring"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:max="100"
                            app:indicatorColor="@color/color_primary"
                            app:indicatorSize="60dp"
                            app:trackColor="@color/rank_track"
                            app:trackCornerRadius="3dp"
                            app:trackThickness="5dp" />

                        <TextView
                            android:id="@+id/profile_rank_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                            android:textColor="@color/color_text_primary"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_rank_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/profile_rank_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.PlantMate.Body"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <include android:id="@+id/profile_trust_email" layout="@layout/item_trust_row" />
                <include android:id="@+id/profile_trust_phone" layout="@layout/item_trust_row" />
                <include android:id="@+id/profile_trust_vneid" layout="@layout/item_trust_row" />
                <include android:id="@+id/profile_trust_photo" layout="@layout/item_trust_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="@color/rank_track" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/trust_history_reviews"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/profile_trust_reviews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.PlantMate.Label"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/trust_history_rehomed"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/profile_trust_rehomed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.PlantMate.Label"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/trust_history_since"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/profile_trust_since"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.PlantMate.Label"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- "Is it still available?": an active listing not updated for 14 days -->
            <LinearLayout
                android:id="@+id/profile_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_ink_panel_20"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profile_check_photo"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/progress_track_on_dark"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_check_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/profile_check_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.PlantMate.Body"
                            android:textColor="@color/color_on_dark_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profile_check_yes"
                        style="@style/Widget.PlantMate.Button.OnInk"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/listing_check_yes"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profile_check_given"
                        style="@style/Widget.PlantMate.Button.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_outline_on_ink_12"
                        android:minHeight="40dp"
                        android:text="@string/listing_check_given"
                        android:textColor="@color/white"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- Listed / Given / Saved -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/profile_tabs"
                style="@style/Widget.PlantMate.UnderlineTabs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

            <LinearLayout
                android:id="@+id/profile_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp" />

            <TextView
                android:id="@+id/profile_cards_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textAppearance="@style/TextAppearance.PlantMate.Body"
                android:textColor="@color/color_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_cards_all"
                style="@style/Widget.PlantMate.Button.Outlined.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:visibility="gone" />

            <!-- Newest review -->
            <LinearLayout
                android:id="@+id/profile_reviews_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/profile_reviews_title"
                        android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle"
                        android:textSize="19sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profile_reviews"
                        style="@style/Widget.PlantMate.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profile_review_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_panel_20"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/profile_review_avatar"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_avatar_neutral"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/profile_review_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.PlantMate.Label"
                                android:textColor="@color/color_text_primary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/profile_review_stars"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/color_star"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/profile_review_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/profile_review_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textSize="15sp"
                        app:lineHeight="22sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Account -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="12dp"
                android:accessibilityHeading="true"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/profile_account_title"
                android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle"
                android:textSize="19sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_panel_20"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/profile_inbox"
                    style="@style/PlantMateAccountRow">

                    <ImageView style="@style/PlantMateAccountIcon" android:src="@drawable/ic_chat" />

                    <TextView style="@style/PlantMateAccountLabel" android:text="@string/profile_inbox" />

                    <TextView
                        android:id="@+id/profile_inbox_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profile_friends"
                    style="@style/PlantMateAccountRow"
                    android:background="@drawable/bg_top_hairline_panel">

                    <ImageView style="@style/PlantMateAccountIcon" android:src="@drawable/ic_users" />

                    <TextView style="@style/PlantMateAccountLabel" android:text="@string/profile_row_friends" />

                    <TextView
                        android:id="@+id/profile_friends_requests"
                        style="@style/Widget.PlantMate.Tag"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_tag_green"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:textColor="@color/color_on_primary"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profile_row_settings"
                    style="@style/PlantMateAccountRow"
                    android:background="@drawable/bg_top_hairline_panel">

                    <ImageView style="@style/PlantMateAccountIcon" android:src="@drawable/ic_settings" />

                    <TextView style="@style/PlantMateAccountLabel" android:text="@string/profile_settings" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/color_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profile_sign_out"
                    style="@style/PlantMateAccountRow"
                    android:background="@drawable/bg_top_hairline_panel">

                    <ImageView
                        style="@style/PlantMateAccountIcon"
                        android:src="@drawable/ic_row_glyph_logout"
                        app:tint="@color/color_danger" />

                    <TextView
                        style="@style/PlantMateAccountLabel"
                        android:text="@string/action_sign_out"
                        android:textColor="@color/color_danger" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/profile_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="120dp"
            android:indeterminate="true"
            app:indicatorColor="@color/color_primary"
            app:trackColor="@color/color_primary_tint" />

        <LinearLayout
            android:id="@+id/profile_error_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_load_error"
                android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_retry"
                style="@style/Widget.PlantMate.Button.Outlined.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/action_retry" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
