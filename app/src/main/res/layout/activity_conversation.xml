<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/conversation_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <!-- Header (canvas "Chat"): back, the other member with a leaf badge, their role and area, safety menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/conversation_back"
            style="@style/Widget.PlantMate.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="24dp" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/conversation_peer_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_neutral"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/conversation_peer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/conversation_peer_verified"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:contentDescription="@string/verified_email"
                    android:src="@drawable/ic_verified"
                    android:visibility="gone"
                    app:tint="@color/color_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/conversation_peer_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.PlantMate.Body"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/conversation_safety"
            style="@style/Widget.PlantMate.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/safety_menu"
            android:enabled="false"
            app:icon="@drawable/ic_more_vert"
            app:iconSize="24dp" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/conversation_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintWidth_max="@dimen/content_max_readable">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/conversation_rate"
                style="@style/Widget.PlantMate.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/content_padding_horizontal"
                android:layout_marginEnd="@dimen/content_padding_horizontal"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/review_rate_member"
                android:visibility="gone" />
            <!-- Listing card (canvas B): grey panel, photo, name, "Give away · Available", chevron; then Asked → Arranged → Picked up -->
            <LinearLayout
                android:id="@+id/conversation_listing_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_panel_16"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/conversation_listing_photo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/color_panel_line"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/conversation_listing_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/conversation_listing_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/conversation_listing_status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/conversation_listing_species"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/conversation_listing_open"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/chat_view_listing"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/color_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/conversation_status_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <include android:id="@+id/conversation_step_active" layout="@layout/item_status_step"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

                    <include android:id="@+id/conversation_step_reserved" layout="@layout/item_status_step"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

                    <include android:id="@+id/conversation_step_rehomed" layout="@layout/item_status_step"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/conversation_messages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/content_padding_horizontal"
                    android:paddingTop="@dimen/spacing_md"
                    android:paddingEnd="@dimen/content_padding_horizontal"
                    android:paddingBottom="@dimen/spacing_md" />
                <TextView
                    android:id="@+id/conversation_no_messages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/conversation_no_messages"
                    android:textColor="@color/color_text_secondary" />
            </FrameLayout>
            <TextView android:id="@+id/conversation_block_notice" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingStart="@dimen/content_padding_horizontal"
                android:paddingEnd="@dimen/content_padding_horizontal" android:paddingBottom="@dimen/spacing_sm"
                android:text="@string/safety_messaging_unavailable" android:textColor="@color/color_text_secondary"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/conversation_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_top_hairline"
                android:orientation="vertical"
                android:paddingTop="10dp">
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/conversation_quick_replies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:singleLine="true" />
            </HorizontalScrollView>
            <!-- Composer (canvas B): mic circle, a grey pill with the message and photo, then ink send -->
            <LinearLayout
                android:id="@+id/conversation_input_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/conversation_mic"
                    style="@style/Widget.PlantMate.IconButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/chat_record_voice"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/color_panel"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_mic"
                    app:iconSize="22dp"
                    app:iconTint="@color/color_text_primary"
                    app:strokeWidth="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_field"
                    android:backgroundTint="@color/color_panel"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="4dp">

                    <EditText
                        android:id="@+id/conversation_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/conversation_input_hint"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="1000"
                        android:maxLines="4"
                        android:minHeight="48dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textColorHint="@color/color_text_secondary"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/conversation_attach"
                        style="@style/Widget.PlantMate.IconButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/chat_attach_photo"
                        app:icon="@drawable/ic_image"
                        app:iconSize="22dp"
                        app:iconTint="@color/color_text_secondary"
                        app:strokeWidth="0dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/conversation_send"
                    style="@style/Widget.PlantMate.IconButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/conversation_send"
                    android:enabled="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/button_primary_background"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_send"
                    app:iconSize="22dp"
                    app:iconTint="@color/color_background"
                    app:strokeWidth="0dp" />
            </LinearLayout>

            <!-- Recording: discard, live timer (max 1:00) and send -->
            <LinearLayout
                android:id="@+id/conversation_recording_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/conversation_record_cancel"
                    style="@style/Widget.PlantMate.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/chat_record_cancel"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/color_chip_surface"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_trash"
                    app:iconTint="@color/color_danger"
                    app:strokeWidth="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_recording_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <View
                        android:id="@+id/conversation_record_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_record_dot" />

                    <TextView
                        android:id="@+id/conversation_record_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.PlantMate.Label"
                        android:textColor="@color/color_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/chat_recording_hint"
                        android:textAppearance="@style/TextAppearance.PlantMate.Meta" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/conversation_record_send"
                    style="@style/Widget.PlantMate.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/chat_record_send"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/color_primary"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_send"
                    app:iconTint="@color/color_on_primary"
                    app:strokeWidth="0dp" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/conversation_upload_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/color_primary"
                app:trackColor="@color/color_primary_tint" />
            </LinearLayout>
        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ProgressBar
        android:indeterminateTint="@color/color_primary"
            android:id="@+id/conversation_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
        <LinearLayout
            android:id="@+id/conversation_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conversation_load_error"
                android:textColor="@color/color_text_secondary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/conversation_retry"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/action_retry" />
        </LinearLayout>
        <TextView
            android:id="@+id/conversation_not_found"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/conversation_not_found"
            android:textColor="@color/color_text_secondary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
