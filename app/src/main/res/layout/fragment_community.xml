<?xml version="1.0" encoding="utf-8"?>
<!-- Community (canvas B "Cộng đồng"): search and inbox top right, the big title, the story strip, a composer
     panel ("Ask, show off or offer a swap…"), underline category tabs, then flat posts split by hairlines. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/communityScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/fab_bottom_clearance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title row (canvas option C, 2026-10-16): title, inbox and "Đăng bài"; search sits beside the composer -->
            <LinearLayout
                android:id="@+id/communityHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/communityTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:letterSpacing="-0.02"
                    android:text="@string/nav_community"
                    android:textAppearance="@style/TextAppearance.PlantMate.Hero"
                    android:textSize="30sp" />

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/communityInbox"
                    style="@style/Widget.PlantMate.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/home_inbox_description"
                    app:icon="@drawable/ic_chat"
                    app:iconSize="24dp"
                    app:strokeWidth="0dp" />
            <TextView
                android:id="@+id/communityInboxBadge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_bell_badge"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:minWidth="20dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/communityFab"
                    style="@style/Widget.PlantMate.Button.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/community_fab_post" />
            </LinearLayout>

            <!-- Search, opened from the top bar, with the sort button inside -->
            <LinearLayout
                android:id="@+id/communitySearchLayout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_search_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/color_text_secondary" />

                <EditText
                    android:id="@+id/communitySearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/community_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body"
                    android:textColorHint="@color/color_text_secondary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/communitySort"
                    style="@style/Widget.PlantMate.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/community_sort_desc"
                    app:icon="@drawable/ic_sliders"
                    app:iconSize="22dp"
                    app:strokeWidth="0dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/communityStories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Composer: one tap to choose what to post -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/communityComposer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_panel_16"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/communityAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_avatar_ink"
                    android:clickable="true"
                    android:contentDescription="@string/home_avatar_desc"
                    android:focusable="true"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                    android:textColor="@color/color_background"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/community_composer_hint"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_image"
                    app:tint="@color/color_text_secondary" />
            </LinearLayout>

                <!-- Search, beside the composer (opens the search field) -->
                <FrameLayout
                    android:id="@+id/communitySearchButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_panel_16"
                    android:clickable="true"
                    android:contentDescription="@string/community_search_hint"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/color_text_primary" />
                </FrameLayout>
            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/communityTabs"
                style="@style/Widget.PlantMate.UnderlineTabs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="260dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/communityList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/communityLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    app:indicatorColor="@color/color_primary"
                    app:trackColor="@color/color_primary_tint" />

                <LinearLayout
                    android:id="@+id/communityEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="120dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mam" />

                    <TextView
                        android:id="@+id/communityEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center"
                        android:text="@string/community_empty_title"
                        android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

                    <TextView
                        android:id="@+id/communityEmptySupporting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="center"
                        android:text="@string/community_empty_supporting"
                        android:textAppearance="@style/TextAppearance.PlantMate.Meta" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/communityEmptyAction"
                        style="@style/Widget.PlantMate.Button.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/community_create_post" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/communityError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/community_load_error"
                        android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/communityRetry"
                        style="@style/Widget.PlantMate.Button.Outlined.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/action_retry" />
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/communityMoreLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:contentDescription="@string/community_loading_more"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/color_primary"
                app:indicatorSize="28dp"
                app:trackColor="@color/color_primary_tint" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
