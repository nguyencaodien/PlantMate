<?xml version="1.0" encoding="utf-8"?>
<!-- Admin overview (MoonRow canvas, 2026-10-21): org header, period switch, three counts with mini bars,
     ink highlight with the change against the period before, listings-by-type gauge, 14-day grid,
     reports by reason; bottom tabs to the lists. Real counts only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_page"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/adminHomeScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/adminHomeGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- Back to the member app: closes every admin screen and opens Home. -->
                <TextView
                    android:id="@+id/adminBackToApp"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_admin_back_pill"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="18dp"
                    android:text="@string/admin_back_to_app"
                    android:textColor="@color/brand_lime"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_arrow_back"
                    app:drawableTint="@color/white" />

                <!-- Org header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_admin_logo"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:text="@string/admin_logo"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/admin_org_title"
                            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/adminHomeMembers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PlantMate.Meta" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/adminHomeRefresh"
                        style="@style/Widget.PlantMate.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/admin_refresh"
                        app:icon="@drawable/ic_refresh"
                        app:iconSize="22dp"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/adminOpenLog"
                        style="@style/Widget.PlantMate.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/admin_log_title"
                        app:icon="@drawable/ic_history_list"
                        app:iconSize="22dp"
                        app:strokeWidth="0dp" />
                </LinearLayout>

                <!-- Period -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_admin_card"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView android:id="@+id/adminPeriodToday" style="@style/PlantMateAdminPeriod" android:text="@string/admin_period_today" />
                    <TextView android:id="@+id/adminPeriodWeek" style="@style/PlantMateAdminPeriod" android:text="@string/admin_period_week" />
                    <TextView android:id="@+id/adminPeriodMonth" style="@style/PlantMateAdminPeriod" android:text="@string/admin_period_month" />
                    <TextView android:id="@+id/adminPeriodAll" style="@style/PlantMateAdminPeriod" android:text="@string/admin_period_all" />
                </LinearLayout>

                <!-- Three counts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/adminStatListings" style="@style/PlantMateAdminCount">
                        <TextView style="@style/PlantMateAdminCountLabel" android:text="@string/admin_listings" />
                        <TextView android:id="@+id/adminCountListings" style="@style/PlantMateAdminCountValue" />
                        <TextView style="@style/PlantMateAdminCountUnit" android:text="@string/admin_unit_listings" />
                        <com.example.ungdungchiasecaycanh.ui.admin.StackedBarView android:id="@+id/adminBarListings" style="@style/PlantMateAdminMiniBar" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/adminStatPosts" style="@style/PlantMateAdminCount" android:layout_marginStart="8dp">
                        <TextView style="@style/PlantMateAdminCountLabel" android:text="@string/admin_posts" />
                        <TextView android:id="@+id/adminCountPosts" style="@style/PlantMateAdminCountValue" />
                        <TextView style="@style/PlantMateAdminCountUnit" android:text="@string/admin_unit_posts" />
                        <com.example.ungdungchiasecaycanh.ui.admin.StackedBarView android:id="@+id/adminBarPosts" style="@style/PlantMateAdminMiniBar" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/adminStatMembers" style="@style/PlantMateAdminCount" android:layout_marginStart="8dp">
                        <TextView style="@style/PlantMateAdminCountLabel" android:text="@string/admin_members" />
                        <TextView android:id="@+id/adminCountMembers" style="@style/PlantMateAdminCountValue" />
                        <TextView style="@style/PlantMateAdminCountUnit" android:text="@string/admin_unit_members" />
                        <com.example.ungdungchiasecaycanh.ui.admin.StackedBarView android:id="@+id/adminBarMembers" style="@style/PlantMateAdminMiniBar" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Ink highlight: activity in the period -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_admin_ink"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/adminHighlightRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/member_hero_text"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/adminHighlightCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/white"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/adminHighlightLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:textColor="@color/member_hero_text"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <com.example.ungdungchiasecaycanh.ui.admin.StackedBarView
                            android:id="@+id/adminHighlightBar"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="10dp" />

                        <LinearLayout
                            android:id="@+id/adminHighlightLegend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/adminHighlightDelta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_admin_pill"
                        android:fontFeatureSettings="tnum"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/color_forest"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Listings by type: half ring and the list beside it -->
                <LinearLayout style="@style/PlantMateAdminCard">

                    <LinearLayout style="@style/PlantMateAdminCardHeader">
                        <TextView style="@style/PlantMateAdminCardTitle" android:text="@string/admin_chart_types" />
                        <TextView
                            android:id="@+id/adminGaugePeriod"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PlantMate.Meta" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.example.ungdungchiasecaycanh.ui.admin.DonutChartView
                            android:id="@+id/adminTypeChart"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.15" />

                        <LinearLayout
                            android:id="@+id/adminTypeLegend"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 14-day grid -->
                <LinearLayout style="@style/PlantMateAdminCard">

                    <LinearLayout style="@style/PlantMateAdminCardHeader">
                        <TextView style="@style/PlantMateAdminCardTitle" android:text="@string/admin_heat_title" />
                        <LinearLayout
                            android:id="@+id/adminHeatLegend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <com.example.ungdungchiasecaycanh.ui.admin.HeatGridView
                        android:id="@+id/adminHeat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />
                </LinearLayout>

                <!-- Reports by reason -->
                <LinearLayout style="@style/PlantMateAdminCard">

                    <LinearLayout style="@style/PlantMateAdminCardHeader">
                        <TextView style="@style/PlantMateAdminCardTitle" android:text="@string/admin_reasons_title" />
                        <TextView
                            android:id="@+id/adminReasonsMore"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:gravity="center_vertical"
                            android:paddingStart="8dp"
                            android:text="@string/admin_reasons_more"
                            android:textAppearance="@style/TextAppearance.PlantMate.Label"
                            android:textColor="@color/color_success" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/adminReasonTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/adminHomeLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/color_success" />

        <LinearLayout
            android:id="@+id/adminHomeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_mint_circle">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/color_on_primary_tint" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/admin_load_error"
                android:textAppearance="@style/TextAppearance.PlantMate.CardTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/adminHomeRetry"
                style="@style/Widget.PlantMate.Button.Tonal.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/action_retry" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/adminTabs"
        style="@style/Widget.PlantMate.BottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:menu="@menu/menu_admin_tabs" />
</LinearLayout>
