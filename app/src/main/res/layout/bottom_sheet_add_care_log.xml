<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/color_surface"
    android:orientation="vertical" android:paddingStart="@dimen/spacing_lg" android:paddingTop="@dimen/spacing_lg"
    android:paddingEnd="@dimen/spacing_lg" android:paddingBottom="@dimen/spacing_xl">
    <TextView android:id="@+id/careSheetTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle"/>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/careNoteLayout" 
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/careNoteInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="top|start" android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500" android:minHeight="100dp" android:maxLines="5" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/careSheetError" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs" android:textColor="@color/color_danger" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/careCancelButton" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/action_cancel" />
        <com.google.android.material.button.MaterialButton android:id="@+id/careSaveButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_sm" android:layout_weight="1" android:text="@string/care_save" />
    </LinearLayout>
</LinearLayout>
