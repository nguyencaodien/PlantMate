<?xml version="1.0" encoding="utf-8"?>
<!-- One notification: coloured round icon, sentence with the member's name in bold, meta line,
     friend-request buttons when needed, and a green dot while unread (tinted background). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:background="@drawable/bg_notification_row"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/notification_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_notification_circle"
        android:contentDescription="@null"
        android:padding="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.PlantMate.Body"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notification_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/notification_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/notification_accept"
                style="@style/Widget.PlantMate.Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/notifications_accept" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/notification_later"
                style="@style/Widget.PlantMate.Button.Outlined.Small"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="@string/notifications_later" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/notification_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dot_green" />
</LinearLayout>
