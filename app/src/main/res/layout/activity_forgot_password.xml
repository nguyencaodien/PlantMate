<?xml version="1.0" encoding="utf-8"?>
<!-- Reset password (current PlantMate style): back + "RESET PASSWORD", a sage card with Mầm,
     a white card with one email field, and a "check your inbox" card that never reveals
     whether an account exists. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/forgotRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgotBack"
                    style="@style/Widget.PlantMate.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical|start"
                    android:contentDescription="@string/action_back"
                    app:backgroundTint="@color/color_surface"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_arrow_back" />

            </FrameLayout>

            <!-- Heading beside Mầm -->
            <FrameLayout
                android:id="@+id/forgotHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="88dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:letterSpacing="-0.02"
                        android:text="@string/forgot_title"
                        android:textAppearance="@style/TextAppearance.PlantMate.ScreenTitle"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/forgot_supporting"
                        android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/forgotBubble"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_bubble_mint"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="@string/forgot_mam_hint"
                        android:textAppearance="@style/TextAppearance.PlantMate.Label"
                        android:textColor="@color/color_primary"
                        android:textSize="12sp"
                        app:lineHeight="16sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/forgotMam"
                    android:layout_width="78dp"
                    android:layout_height="111dp"
                    android:layout_gravity="center_vertical|end"
                    android:contentDescription="@null"
                    android:src="@drawable/avd_mam" />
            </FrameLayout>

            <!-- Form -->
            <LinearLayout
                android:id="@+id/forgotForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/forgotEmail"
                    android:text="@string/label_email"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/color_text_primary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/forgotEmailLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_mail"
                    app:startIconTint="@color/color_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/forgotEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:autofillHints="emailAddress"
                        android:hint="@string/hint_email"
                        android:inputType="textEmailAddress"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/forgotError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_status_unavailable"
                    android:padding="12dp"
                    android:text="@string/forgot_send_error"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/color_danger"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgotSend"
                    style="@style/Widget.PlantMate.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/forgot_send"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_mail"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:iconTint="@color/color_primary_button_icon" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/forgot_note"
                    android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Sent -->
            <LinearLayout
                android:id="@+id/forgotSent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_form_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="22dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_forest_circle">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        app:tint="@color/color_accent" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:accessibilityHeading="true"
                    android:text="@string/forgot_sent_title"
                    android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

                <TextView
                    android:id="@+id/forgotSentBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgotDone"
                    style="@style/Widget.PlantMate.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/forgot_back_to_sign_in"
                    app:cornerRadius="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgotResend"
                    style="@style/Widget.PlantMate.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/forgot_send_again" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
