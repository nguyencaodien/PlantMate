<?xml version="1.0" encoding="utf-8"?>
<!-- New listing (canvas B "Đăng tin"): close and "Save draft", title, the three type cards, photos, a grey panel
     with name, species, kind and condition, "Size & pot" (height and pot steppers, pot included, age), the swap or
     sale fields for that type, "Description & pick-up" (description, area, free times), and a footer with
     "Save draft" and "Preview listing". -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/create_listing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Close · save draft -->
        <LinearLayout
            android:id="@+id/create_listing_hero"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_create_listing_back"
                style="@style/Widget.PlantMate.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/create_listing_back_description"
                app:icon="@drawable/ic_close"
                app:strokeWidth="0dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/create_listing_draft_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/create_listing_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/create_listing_title"
                    android:textAppearance="@style/TextAppearance.PlantMate.Hero"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/create_listing_subtitle"
                    android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                    android:textSize="14sp" />

                <!-- Type -->
                <TextView
                    android:id="@+id/create_listing_type_title"
                    style="@style/PlantMateFormLabel"
                    android:layout_marginTop="24dp"
                    android:text="@string/create_listing_type_title" />

                <LinearLayout
                    android:id="@+id/listing_type_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/listing_type_give_away"
                        layout="@layout/item_type_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/listing_type_trade"
                        layout="@layout/item_type_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/listing_type_sell"
                        layout="@layout/item_type_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Photos -->
                <LinearLayout
                    android:id="@+id/create_listing_photos_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/create_listing_photos_label"
                        android:textAppearance="@style/TextAppearance.PlantMate.FormLabel" />

                    <TextView
                        android:id="@+id/listing_photo_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/listing_photo_count_initial"
                        android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listing_image_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:minHeight="96dp"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/create_listing_photo_hint"
                    android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                    android:textSize="13sp" />

                <!-- Name, species, kind, condition -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_panel_20"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        style="@style/PlantMateFormLabel"
                        android:layout_marginTop="16dp"
                        android:text="@string/listing_nickname_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/listing_nickname_layout"
                        style="@style/Widget.PlantMate.TextInputLayout.OnPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/listing_nickname_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/listing_nickname_hint"
                            android:minHeight="52dp"
                            android:singleLine="true"
                            android:textAppearance="@style/TextAppearance.PlantMate.Body"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/PlantMateFormLabel"
                        android:layout_marginTop="16dp"
                        android:text="@string/create_listing_species_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/listing_species_layout"
                        style="@style/Widget.PlantMate.TextInputLayout.OnPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/listing_species_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/listing_species_hint"
                            android:minHeight="52dp"
                            android:singleLine="true"
                            android:textAppearance="@style/TextAppearance.PlantMate.Body"
                            android:textSize="16sp"
                            android:textStyle="italic" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/PlantMateFormLabel"
                        android:layout_marginTop="16dp"
                        android:text="@string/create_listing_category_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/create_listing_category_layout"
                        style="@style/Widget.PlantMate.TextInputLayout.OnPanel.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false">

                        <AutoCompleteTextView
                            android:id="@+id/create_listing_category"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/create_listing_category_hint"
                            android:inputType="none"
                            android:minHeight="52dp"
                            android:paddingStart="16dp"
                            android:textAppearance="@style/TextAppearance.PlantMate.Body"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/PlantMateFormLabel"
                        android:layout_marginTop="16dp"
                        android:text="@string/create_listing_condition_label" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/create_listing_condition_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp" />
                </LinearLayout>

                <!-- Size & pot -->
                <TextView
                    style="@style/PlantMateFormLabel"
                    android:layout_marginTop="28dp"
                    android:accessibilityHeading="true"
                    android:text="@string/create_listing_size_title"
                    android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle"
                    android:textSize="19sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel_20"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_listing_height_label"
                                android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_listing_height_sub"
                                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <include
                            android:id="@+id/create_listing_height_stepper"
                            layout="@layout/view_stepper" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_listing_pot_label"
                                android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_listing_pot_sub"
                                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <include
                            android:id="@+id/create_listing_pot_stepper"
                            layout="@layout/view_stepper" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/create_listing_with_pot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/create_listing_with_pot"
                        android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                        android:textSize="16sp"
                        app:thumbTint="@color/switch_thumb"
                        app:trackDecorationTint="@android:color/transparent"
                        app:trackTint="@color/switch_track" />

                    <TextView
                        style="@style/PlantMateFormLabel"
                        android:layout_marginTop="12dp"
                        android:text="@string/create_listing_age_label" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/create_listing_age_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp"
                        app:selectionRequired="false"
                        app:singleSelection="true" />
                </LinearLayout>

                <!-- Trade: what for -->
                <LinearLayout
                    android:id="@+id/listing_looking_for_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_panel_20"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/PlantMateFormLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/listing_looking_for_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/listing_looking_for_layout"
                        style="@style/Widget.PlantMate.TextInputLayout.OnPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/ic_swap"
                        app:startIconTint="@color/color_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/listing_looking_for_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/listing_looking_for_hint"
                            android:minHeight="52dp"
                            android:singleLine="true"
                            android:textAppearance="@style/TextAppearance.PlantMate.Body"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Sell: price and negotiable -->
                <LinearLayout
                    android:id="@+id/listing_price_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_panel_20"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/PlantMateFormLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/listing_price_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/listing_price_layout"
                        style="@style/Widget.PlantMate.TextInputLayout.OnPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:suffixText="₫">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/listing_price_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/listing_price_hint"
                            android:inputType="number"
                            android:minHeight="52dp"
                            android:singleLine="true"
                            android:textAppearance="@style/TextAppearance.PlantMate.Body"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/listing_negotiable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/create_listing_negotiable"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textSize="15sp"
                        app:thumbTint="@color/switch_thumb"
                        app:trackDecorationTint="@android:color/transparent"
                        app:trackTint="@color/switch_track" />

                    <TextView
                        android:id="@+id/listing_sell_verify_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="10dp"
                        android:text="@string/listing_sell_verify_note"
                        android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                        android:textSize="13sp"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_mail"
                        app:drawableTint="@color/color_primary" />
                </LinearLayout>

                <!-- Description & pick-up -->
                <TextView
                    style="@style/PlantMateFormLabel"
                    android:layout_marginTop="28dp"
                    android:accessibilityHeading="true"
                    android:text="@string/create_listing_describe_title"
                    android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle"
                    android:textSize="19sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel_20"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        style="@style/PlantMateFormLabel"
                        android:layout_marginTop="16dp"
                        android:text="@string/listing_description_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/listing_description_layout"
                        style="@style/Widget.PlantMate.TextInputLayout.OnPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:counterEnabled="true"
                        app:counterMaxLength="1000"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/listing_description_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:hint="@string/listing_description_hint"
                            android:inputType="textCapSentences|textMultiLine"
                            android:minHeight="104dp"
                            android:textAppearance="@style/TextAppearance.PlantMate.Body"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/PlantMateFormLabel"
                        android:layout_marginTop="12dp"
                        android:text="@string/create_listing_pickup_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/listing_location_layout"
                        style="@style/Widget.PlantMate.TextInputLayout.OnPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:helperText="@string/listing_location_helper"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/ic_location"
                        app:startIconTint="@color/color_text_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/listing_location_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/listing_location_hint"
                            android:inputType="textCapWords"
                            android:minHeight="52dp"
                            android:singleLine="true"
                            android:textAppearance="@style/TextAppearance.PlantMate.Body"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/PlantMateFormLabel"
                        android:layout_marginTop="12dp"
                        android:text="@string/create_listing_pickup_times" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/create_listing_pickup_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Save draft · preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_top_hairline"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/create_listing_save_draft"
                style="@style/Widget.PlantMate.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/create_listing_save_draft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_preview_listing"
                style="@style/Widget.PlantMate.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/create_listing_preview" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
