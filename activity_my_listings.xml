<?xml version="1.0" encoding="utf-8"?>
<!-- My listings, Vivid Green: forest header, status filters, listing cards with status pills. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/my_listings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/my_listings_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/my_listings_back"
                style="@style/Widget.PlantMate.IconButton.Hero"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/my_listings_back"
                app:icon="@drawable/ic_arrow_back" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="-0.02"
            android:text="@string/my_listings_title"
            android:textAppearance="@style/TextAppearance.PlantMate.Hero"
            android:textColor="@color/color_hero_text" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/my_listings_supporting"
            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
            android:textColor="@color/color_hero_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/my_listings_filter_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/my_listings_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/my_filter_all"
                style="@style/PlantMateFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checked="true"
                android:text="@string/my_filter_all" />
            <com.google.android.material.chip.Chip
                android:id="@+id/my_filter_active"
                style="@style/PlantMateFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_filter_active" />
            <com.google.android.material.chip.Chip
                android:id="@+id/my_filter_reserved"
                style="@style/PlantMateFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_filter_reserved" />
            <com.google.android.material.chip.Chip
                android:id="@+id/my_filter_rehomed"
                style="@style/PlantMateFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_filter_rehomed" />
            <com.google.android.material.chip.Chip
                android:id="@+id/my_filter_unavailable"
                style="@style/PlantMateFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_filter_unavailable" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/my_listings_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/my_listings_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/color_success"
            app:trackColor="@color/color_primary_tint" />

        <LinearLayout
            android:id="@+id/my_listings_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="24dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/my_listings_mam"
                android:layout_width="96dp"
                android:layout_height="137dp"
                android:contentDescription="@null"
                android:src="@drawable/avd_mam" />

            <TextView
                android:id="@+id/my_listings_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text=""
                android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

            <TextView
                android:id="@+id/my_listings_empty_supporting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text=""
                android:textAppearance="@style/TextAppearance.PlantMate.Meta" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/my_listings_share_plant"
                style="@style/Widget.PlantMate.Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/my_listings_share_plant" />
        </LinearLayout>

        <TextView
            android:id="@+id/my_listings_filtered_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:textAppearance="@style/TextAppearance.PlantMate.Body"
            android:textColor="@color/color_text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/my_listings_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_mint_circle">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/color_on_primary_tint" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/my_listings_load_error"
                android:textAppearance="@style/TextAppearance.PlantMate.CardTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/my_listings_retry"
                style="@style/Widget.PlantMate.Button.Tonal.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/action_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
