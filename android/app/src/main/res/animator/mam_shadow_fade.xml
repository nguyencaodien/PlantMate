<?xml version="1.0" encoding="utf-8"?>
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="2400"
    android:repeatCount="infinite">
        <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
            <keyframe android:fraction="0" android:value="0.18" />
            <keyframe android:fraction="0.5" android:value="0.1" android:interpolator="@interpolator/pm_ease_in_out" />
            <keyframe android:fraction="1" android:value="0.18" android:interpolator="@interpolator/pm_ease_in_out" />
        </propertyValuesHolder>
</objectAnimator>
