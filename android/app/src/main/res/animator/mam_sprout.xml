<?xml version="1.0" encoding="utf-8"?>
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="3000"
    android:repeatCount="infinite">
        <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
            <keyframe android:fraction="0" android:value="-7" />
            <keyframe android:fraction="0.5" android:value="7" android:interpolator="@interpolator/pm_ease_in_out" />
            <keyframe android:fraction="1" android:value="-7" android:interpolator="@interpolator/pm_ease_in_out" />
        </propertyValuesHolder>
</objectAnimator>
