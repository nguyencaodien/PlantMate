<?xml version="1.0" encoding="utf-8"?>
<!-- Page colour with a hairline along the top (bottom action bars). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="@color/color_background" /></shape></item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="@color/color_border" /></shape>
    </item>
</layer-list>
