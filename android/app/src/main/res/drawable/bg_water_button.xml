<?xml version="1.0" encoding="utf-8"?>
<!-- "Water" button (canvas B): white with a hairline; pressing raises a green fill from the bottom (level). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_background" />
            <stroke android:width="1dp" android:color="@color/color_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:id="@+id/water_fill">
        <clip android:clipOrientation="vertical" android:gravity="bottom">
            <shape android:shape="rectangle">
                <solid android:color="@color/color_primary" />
                <corners android:radius="12dp" />
            </shape>
        </clip>
    </item>
</layer-list>
