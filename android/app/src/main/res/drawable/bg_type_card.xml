<?xml version="1.0" encoding="utf-8"?>
<!-- Listing type choice (canvas B): 2dp ink ring when selected, hairline otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_background" />
            <stroke android:width="2dp" android:color="@color/color_text_primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_background" />
            <stroke android:width="1dp" android:color="@color/color_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
