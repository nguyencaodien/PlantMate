<?xml version="1.0" encoding="utf-8"?>
<!-- Underline tab: a 2.5dp green bar along the bottom when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:gravity="bottom" android:height="2.5dp">
                <shape android:shape="rectangle"><solid android:color="@color/color_primary" /></shape>
            </item>
        </layer-list>
    </item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
