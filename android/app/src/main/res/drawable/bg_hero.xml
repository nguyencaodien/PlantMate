<?xml version="1.0" encoding="utf-8"?>
<!-- Former hero panel. Secondary screens now sit on the lime-wash page ground (bg_composer), so the
     hero is transparent; the glow layer id stays for Motion.glow and draws nothing. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:id="@+id/hero_glow">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
