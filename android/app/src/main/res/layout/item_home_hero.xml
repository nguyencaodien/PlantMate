<?xml version="1.0" encoding="utf-8"?>
<!-- Home "Featured near you" card (approved mockup C1, 2026-10-16): a 160×220dp photo card in a sideways
     strip. The type tag sits top-left; the plant's name and the sharer (avatar and name) sit on a dark fade
     at the bottom. HomeFragment drifts the strip right to left after a
     few seconds on Home. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="220dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_panel_16"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    android:foreground="@drawable/fg_hero_card_ripple"
    android:stateListAnimator="@animator/pm_press">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/hero_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_panel_16"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame16" />

    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hero_card_fade" />

    <TextView
        android:id="@+id/hero_tag"
        style="@style/Widget.PlantMate.Tag"
        android:layout_height="22dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/hero_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/hero_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/hero_owner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hero_avatar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_avatar_white"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/ink_on_photo"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hero_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
