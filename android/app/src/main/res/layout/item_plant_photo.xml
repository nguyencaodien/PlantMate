<?xml version="1.0" encoding="utf-8"?>
<!-- One photo on a plant's "photos over time" strip: 92x112 photo and its month. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="92dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:orientation="vertical">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/plantPhotoImage"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@color/color_primary_tint"
        android:contentDescription="@string/garden_plant_photo"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame18" />

    <TextView
        android:id="@+id/plantPhotoDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PlantMate.Tag"
        android:textColor="@color/color_text_primary" />
</LinearLayout>
