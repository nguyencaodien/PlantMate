<?xml version="1.0" encoding="utf-8"?>
<!-- Admin: a member profile, edit and suspension. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminMember"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/adminMemberScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/adminMemberHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/adminMemberBack"
                        style="@style/Widget.PlantMate.IconButton.Hero"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/action_back"
                        app:icon="@drawable/ic_arrow_back" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                </LinearLayout>

                <TextView
                    android:id="@+id/adminMemberTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="-0.02"
                    android:textAppearance="@style/TextAppearance.PlantMate.Hero"
                    android:textColor="@color/color_hero_text" />
                <TextView
                    android:id="@+id/adminMemberUid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                    android:textColor="@color/color_hero_text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="26dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_lime_pill"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:text="@string/admin_badge"
                    android:textAppearance="@style/TextAppearance.PlantMate.Tag"
                    android:textColor="#FF0A3622"
                    app:drawableStartCompat="@drawable/ic_lock"
                    app:drawableTint="#FF0A3622" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/adminMemberForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/adminMemberStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_status_active"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textAppearance="@style/TextAppearance.PlantMate.Label"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/adminMemberCounts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Admin role (admin role canvas A): switch, confirmed in a dialog, logged. -->
                <LinearLayout
                    android:id="@+id/adminMemberRoleCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_admin_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_mint_14">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/color_on_primary_tint" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_role_title"
                            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/adminMemberRoleSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_role_sub"
                            android:textAppearance="@style/TextAppearance.PlantMate.Meta" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/adminMemberRoleSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/admin_role_title" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/edit_profile_name_label"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/color_text_primary"
                    android:textFontWeight="700" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/adminMemberNameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_nav_profile"
                    app:startIconTint="@color/color_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/adminMemberName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:inputType="textPersonName|textCapWords"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/edit_profile_location_label"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/color_text_primary"
                    android:textFontWeight="700" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/adminMemberLocationLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_location_small"
                    app:startIconTint="@color/color_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/adminMemberLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:inputType="textCapWords"
                        android:maxLength="100"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/edit_profile_bio_label"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/color_text_primary"
                    android:textFontWeight="700" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/adminMemberBioLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:hintEnabled="false"
                    app:counterEnabled="true"
                    app:counterMaxLength="500">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/adminMemberBio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="110dp"
                        android:gravity="top|start"
                        android:paddingTop="16dp"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="500"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/admin_note_label"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/color_text_primary"
                    android:textFontWeight="700" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/adminMemberNoteLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_text"
                    app:startIconTint="@color/color_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/adminMemberNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:hint="@string/admin_note_hint"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="500"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/adminMemberSave"
                    style="@style/Widget.PlantMate.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="22dp"
                    android:text="@string/admin_save"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:iconTint="@color/color_primary_button_icon" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/adminMemberSuspend"
                    style="@style/Widget.PlantMate.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/admin_suspend_member"
                    android:textColor="@color/color_danger"
                    app:icon="@drawable/ic_lock"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:iconTint="@color/color_danger"
                    app:strokeColor="@color/color_danger" />

                <TextView
                    android:id="@+id/adminMemberListingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/admin_member_listings"
                    android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

                <LinearLayout
                    android:id="@+id/adminMemberListings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/adminMemberPostsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/admin_member_posts"
                    android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

                <LinearLayout
                    android:id="@+id/adminMemberPosts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/adminMemberAccountNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_mint_24"
                    android:drawablePadding="10dp"
                    android:padding="14dp"
                    android:text="@string/admin_member_account_note"
                    android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                    android:textColor="@color/color_on_primary_tint"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/ic_lock"
                    app:drawableTint="@color/color_success" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/adminMemberLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/color_success" />

    <LinearLayout
        android:id="@+id/adminMemberError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_mint_circle">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_refresh"
                app:tint="@color/color_on_primary_tint" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/admin_load_error"
            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminMemberRetry"
            style="@style/Widget.PlantMate.Button.Tonal.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/action_retry" />
    </LinearLayout>
</FrameLayout>
