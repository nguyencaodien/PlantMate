<?xml version="1.0" encoding="utf-8"?>
<!-- First Google sign-in: confirm the display name and add the pick-up area (required for a
     PlantMate profile). Current style: sage card with Mầm, white form card, pill button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/completeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_composer"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Sage card with Mầm -->
            <FrameLayout
                android:id="@+id/completeHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_feature_card"
                android:minHeight="160dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="96dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:letterSpacing="-0.02"
                        android:text="@string/complete_profile_title"
                        android:textAppearance="@style/TextAppearance.PlantMate.ScreenTitle"
                        android:textColor="@android:color/white"
                        android:textSize="26sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/complete_profile_supporting"
                        android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                        android:textColor="@color/color_on_leaf_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/completeMam"
                    android:layout_width="78dp"
                    android:layout_height="111dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/avd_mam" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/completeForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_form_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/completeName"
                    android:text="@string/label_display_name"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/color_text_primary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/completeNameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_nav_profile"
                    app:startIconTint="@color/color_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/completeName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="name"
                        android:hint="@string/hint_display_name"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="60"
                        android:minHeight="52dp"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/completeLocation"
                    android:text="@string/register_label_location"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/color_text_primary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/completeLocationLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:helperText="@string/listing_location_helper"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_location"
                    app:startIconTint="@color/color_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/completeLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/register_hint_location"
                        android:inputType="textPostalAddress|textCapWords"
                        android:maxLength="100"
                        android:minHeight="52dp"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/completeBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/completeSave"
            style="@style/Widget.PlantMate.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/complete_profile_save"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/completeCancel"
            style="@style/Widget.PlantMate.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/complete_profile_cancel" />
    </LinearLayout>
</LinearLayout>
