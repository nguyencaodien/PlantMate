<?xml version="1.0" encoding="utf-8"?>
<!-- Doctor history (current style): lime wash, back + "DIAGNOSIS HISTORY", then scan cards;
     Mầm explains an empty history. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/doctorHistoryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_composer"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doctorHistoryBack"
            style="@style/Widget.PlantMate.IconButton.Hero"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/garden_back"
            app:icon="@drawable/ic_arrow_back" />

    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:text="@string/doctor_history_title"
        android:textAppearance="@style/TextAppearance.PlantMate.ScreenTitle"
        android:textSize="26sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/doctorHistoryList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/doctorHistoryLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/color_success" />

        <LinearLayout
            android:id="@+id/doctorHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg"
            android:visibility="gone">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="120dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mam" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/doctor_history_empty_title"
                android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:text="@string/doctor_history_empty_supporting"
                android:textAppearance="@style/TextAppearance.PlantMate.Meta" />
        </LinearLayout>

        <TextView
            android:id="@+id/doctorHistoryError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/spacing_lg"
            android:text="@string/doctor_auth_required"
            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
