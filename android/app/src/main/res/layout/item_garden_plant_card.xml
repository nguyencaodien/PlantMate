<?xml version="1.0" encoding="utf-8"?>
<!-- Garden plant card (canvas B): grey panel, square photo with a status tag, name, area, next watering and a
     bar of how much time is left until it is due. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_panel_20"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_task_photo">

        <ImageView
            android:id="@+id/ringPlaceholder"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_botanical_placeholder" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ringPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame14" />

        <TextView
            android:id="@+id/ringDue"
            style="@style/Widget.PlantMate.Tag"
            android:layout_height="24dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_tag_green"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/garden_tag_water"
            android:textColor="@color/color_on_primary"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/ringName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/ringRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PlantMate.Meta"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/ringStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PlantMate.Body"
        android:textSize="13sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/ringProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:importantForAccessibility="no"
        android:max="100"
        app:indicatorColor="@color/color_primary"
        app:trackColor="@color/color_panel_line"
        app:trackCornerRadius="3dp"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="6dp" />
</LinearLayout>
