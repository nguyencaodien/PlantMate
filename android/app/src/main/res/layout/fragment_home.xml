<?xml version="1.0" encoding="utf-8"?>
<!-- Home (canvas "Trang chủ"). One RecyclerView scrolls everything: the header item
     (item_home_header) first, then the two-column listing grid, so listings are recycled. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/home_listing_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/fab_bottom_clearance" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
