<?xml version="1.0" encoding="utf-8"?>
<!-- Plant Doctor result (canvas B "Kết quả chẩn đoán"): back · "Result" · history and share, the photo, the plant
     and its scientific name, a panel with the condition and how sure Mầm is, Mầm's plain answer, the diagnosis,
     "What to do" as check rows (ticked rows get a green box and a "Done" tag, never struck through), neighbours
     giving this plant, "Was this right?", the disclaimer, and a footer with "Save to garden" and "Ask Mầm". -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/doctorResultRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/doctorResultContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="104dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/doctorResultHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/doctorResultBack"
                    style="@style/Widget.PlantMate.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/action_back"
                    app:icon="@drawable/ic_arrow_back"
                    app:strokeWidth="0dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/doctor_result_title_b"
                    android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/doctorResultHistory"
                    style="@style/Widget.PlantMate.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/doctor_history_title"
                    app:icon="@drawable/ic_history"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/doctorResultShare"
                    style="@style/Widget.PlantMate.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/doctor_result_share"
                    app:icon="@drawable/ic_share"
                    app:strokeWidth="0dp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/doctorResultPhotoCard"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="20dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/doctorResultImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_panel_20"
                    android:contentDescription="@string/doctor_preview_description"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame20" />

                <TextView
                    android:id="@+id/doctorResultDate"
                    style="@style/Widget.PlantMate.Tag"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_tag_white"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:textColor="@color/ink_on_photo"
                    android:textSize="12sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/doctorResultPlantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:accessibilityHeading="true"
                android:letterSpacing="-0.02"
                android:textAppearance="@style/TextAppearance.PlantMate.Hero"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/doctorResultScientific"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                android:textSize="14sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/doctorResultPlant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="20dp"
                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Condition and how sure Mầm is -->
            <LinearLayout
                android:id="@+id/doctorResultDiagnosisCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_panel_20"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/doctor_result_condition"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/doctorResultHealth"
                        style="@style/Widget.PlantMate.Tag"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_tag_soft"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:drawablePadding="6dp"
                        android:textColor="@color/color_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/doctorResultConfidenceRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/doctor_result_sure"
                            android:textAppearance="@style/TextAppearance.PlantMate.Body"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/doctorResultConfidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="@style/TextAppearance.PlantMate.Label"
                            android:textColor="@color/color_text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/doctorResultConfidenceBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:max="100"
                        app:indicatorColor="@color/color_text_primary"
                        app:trackColor="@color/color_panel_line"
                        app:trackCornerRadius="3dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mầm says it plainly -->
            <LinearLayout
                android:id="@+id/doctorResultMamRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_tint_panel_16"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/doctorResultMam"
                    android:layout_width="28dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mam_look" />

                <TextView
                    android:id="@+id/doctorResultMamSays"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                style="@style/PlantMateSectionHeading"
                android:text="@string/doctor_result_diagnosis_title" />

            <TextView
                android:id="@+id/doctorResultDiagnosis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_panel_20"
                android:padding="16dp"
                android:textAppearance="@style/TextAppearance.PlantMate.Body"
                android:textSize="15sp"
                app:lineHeight="22sp" />

            <!-- What to do -->
            <LinearLayout
                android:id="@+id/doctorResultCareCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/doctor_result_todo_title"
                        android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/doctorResultStepsDone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/doctorResultSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />
            </LinearLayout>

            <!-- Neighbours giving this plant away -->
            <LinearLayout
                android:id="@+id/doctorResultGivers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_tint_panel_16"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_gift"
                    app:tint="@color/color_primary" />

                <TextView
                    android:id="@+id/doctorResultGiversText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/color_primary" />
            </LinearLayout>

            <!-- Was this right? Answers measure Plant Doctor and build data to train it. -->
            <LinearLayout
                android:id="@+id/doctorResultFeedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_panel_20"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/doctorResultFeedbackBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/doctor_feedback_title"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/doctorResultFeedbackButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/doctorResultFeedbackYes"
                        style="@style/Widget.PlantMate.Button.Outlined.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/doctor_feedback_yes"
                        app:backgroundTint="@color/color_background"
                        app:cornerRadius="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/doctorResultFeedbackNo"
                        style="@style/Widget.PlantMate.Button.Outlined.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/doctor_feedback_no"
                        app:backgroundTint="@color/color_background"
                        app:cornerRadius="20dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:text="@string/doctor_result_disclaimer"
                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Save to garden · ask Mầm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_top_hairline"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doctorResultAddPlant"
            style="@style/Widget.PlantMate.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/doctor_result_save_garden" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doctorResultAskMam"
            style="@style/Widget.PlantMate.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/home_ask_mam_more" />
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/doctorResultLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="@color/color_primary"
        app:trackColor="@color/color_primary_tint" />

    <LinearLayout
        android:id="@+id/doctorResultError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg"
        android:visibility="gone">

        <TextView
            android:id="@+id/doctorResultErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doctorResultRetry"
            style="@style/Widget.PlantMate.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/action_retry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doctorResultErrorBack"
            style="@style/Widget.PlantMate.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_back" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
