<?xml version="1.0" encoding="utf-8"?>
<!-- Composer (Roundtable-inspired): close, "COMPOSER" and a Publish pill; the author with an
     audience chip and a topic chip; a borderless text field; the photo preview; and a tool row
     (photo, topic) with the character counter above the keyboard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/createPostRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_composer"
    android:orientation="vertical">

    <!-- Top bar -->
    <FrameLayout
        android:id="@+id/createPostBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createPostBack"
            style="@style/Widget.PlantMate.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/composer_close"
            app:backgroundTint="@color/color_surface"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_close" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="52dp"
            android:accessibilityHeading="true"
            android:text="@string/composer_title"
            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/postSubmit"
            style="@style/Widget.PlantMate.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical|end"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="88dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/composer_publish"
            android:textColor="@color/color_surface"
            app:backgroundTint="@color/color_text_primary"
            app:cornerRadius="14dp" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/createPostForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Author, audience and topic -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/createPostAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_lime_circle"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/color_on_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/createPostAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.PlantMate.Label"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="32dp"
                            android:background="@drawable/bg_composer_chip"
                            android:drawablePadding="5dp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/composer_audience"
                            android:textAppearance="@style/TextAppearance.PlantMate.Label"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ic_globe"
                            app:drawableTint="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/postCategoryChip"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_composer_chip"
                            android:clickable="true"
                            android:drawablePadding="5dp"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:textAppearance="@style/TextAppearance.PlantMate.Label"
                            android:textSize="12sp"
                            app:drawableEndCompat="@drawable/ic_chevron_down"
                            app:drawableStartCompat="@drawable/ic_tag"
                            app:drawableTint="@color/color_text_primary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Listing shared from its detail screen -->
            <LinearLayout
                android:id="@+id/postAttachedListing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_mint_14"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/postAttachedListingName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/postAttachedListingMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/postTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="@string/composer_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="3dp"
                android:maxLength="2000"
                android:minLines="4"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textAppearance="@style/TextAppearance.PlantMate.Body"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_secondary"
                android:textCursorDrawable="@null"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/postError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                android:textColor="@color/color_danger"
                android:visibility="gone" />

            <!-- Photo preview -->
            <FrameLayout
                android:id="@+id/postPhotoCard"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/postPhotoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_primary_tint"
                    android:contentDescription="@string/community_post_photo"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame16" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/postPhotoRemove"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/post_photo_remove"
                    app:backgroundTint="#B31A231D"
                    app:icon="@drawable/ic_close"
                    app:iconSize="18dp"
                    app:iconTint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="28dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_dark_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/composer_photo_note"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Tools -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_border" />

    <LinearLayout
        android:id="@+id/createPostTools"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/postToolPhoto"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/composer_add_photo"
            app:icon="@drawable/ic_image"
            app:iconTint="@color/color_success" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/postToolCategory"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/composer_pick_category"
            app:icon="@drawable/ic_tag"
            app:iconTint="@color/color_text_secondary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/postCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
