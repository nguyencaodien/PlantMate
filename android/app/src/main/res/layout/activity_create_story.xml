<?xml version="1.0" encoding="utf-8"?>
<!-- New story ("Tạo tin", canvas Community "Khoảnh khắc xanh"): close and title; a tall photo
     (tap to choose); a short title with suggestions; an optional caption; who sees it; Share. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/storyCreateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/storyCreateClose"
            style="@style/Widget.PlantMate.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/composer_close"
            app:icon="@drawable/ic_close" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="52dp"
            android:accessibilityHeading="true"
            android:text="@string/story_create_title"
            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
            android:textSize="18sp" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/storyCreateForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Photo: 3:4 preview of the 9:16 story; the empty state is the picker -->
            <FrameLayout
                android:id="@+id/storyPhotoFrame"
                android:layout_width="220dp"
                android:layout_height="340dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_dashed_tile_18"
                android:clickable="true"
                android:contentDescription="@string/story_pick_photo"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:id="@+id/storyPhotoEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_mint_circle"
                        android:importantForAccessibility="no"
                        android:padding="15dp"
                        android:src="@drawable/ic_camera_add"
                        app:tint="@color/color_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/story_pick_photo"
                        android:textAppearance="@style/TextAppearance.PlantMate.Label"
                        android:textColor="@color/color_text_primary" />
                </LinearLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/storyPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame18" />

                <TextView
                    android:id="@+id/storyPhotoChange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_hint_chip_dark"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:text="@string/story_change_photo"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_camera"
                    app:drawableTint="@color/white" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/storyTitleInput"
                android:text="@string/story_title_label"
                android:textAppearance="@style/TextAppearance.PlantMate.FormLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/storyTitleLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:counterEnabled="true"
                app:counterMaxLength="24"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/storyTitleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:hint="@string/story_title_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="24"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/storyTitleSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="2dp"
                app:selectionRequired="false"
                app:singleSelection="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/storyCaptionInput"
                android:text="@string/story_caption_label"
                android:textAppearance="@style/TextAppearance.PlantMate.FormLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:counterEnabled="true"
                app:counterMaxLength="200"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/storyCaptionInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="@string/story_caption_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="200"
                    android:minLines="3"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_note_mint"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="@string/story_visibility_note"
                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                android:textColor="@color/color_text_primary"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_users"
                app:drawableTint="@color/color_primary" />

            <TextView
                android:id="@+id/storyCreateError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                android:textColor="@color/color_danger"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_hairline"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/storyPublish"
            style="@style/Widget.PlantMate.Button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/story_publish"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconSize="19dp" />
    </FrameLayout>
</LinearLayout>
