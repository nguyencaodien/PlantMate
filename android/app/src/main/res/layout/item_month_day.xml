<?xml version="1.0" encoding="utf-8"?>
<!-- One day in the month calendar: number over the week strip's dot; the selected day is filled ink. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:layout_weight="1"
    android:gravity="center"
    android:minHeight="48dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/monthDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.PlantMate.Label"
        android:textColor="@color/color_text_primary"
        android:textSize="14sp" />

    <View
        android:id="@+id/monthDayDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="4dp" />
</LinearLayout>
