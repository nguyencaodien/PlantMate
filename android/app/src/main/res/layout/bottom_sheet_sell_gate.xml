<?xml version="1.0" encoding="utf-8"?>
<!-- Selling needs email + phone + VNeID (trust canvas 3). Give Away and Trade never see this. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/sell_gate_title"
            android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/sell_gate_body"
            android:textAppearance="@style/TextAppearance.PlantMate.Body"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />

        <include android:id="@+id/sell_gate_email" layout="@layout/item_trust_row" />
        <include android:id="@+id/sell_gate_phone" layout="@layout/item_trust_row" />
        <include android:id="@+id/sell_gate_vneid" layout="@layout/item_trust_row" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sell_gate_continue"
            style="@style/Widget.PlantMate.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/sell_gate_continue" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/sell_gate_note"
            android:textAppearance="@style/TextAppearance.PlantMate.Body"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
