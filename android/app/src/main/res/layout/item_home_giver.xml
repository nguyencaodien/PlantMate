<?xml version="1.0" encoding="utf-8"?>
<!-- "Givers near you" card (canvas B): 150dp grey panel, 56dp avatar, name, plants on offer, "View profile". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_panel_20"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="16dp"
    android:paddingEnd="12dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/giver_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_avatar_neutral"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/color_text_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/giver_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/giver_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PlantMate.Meta"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/giver_view"
        style="@style/Widget.PlantMate.Button.Outlined.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/home_giver_view" />
</LinearLayout>
