<?xml version="1.0" encoding="utf-8"?>
<!-- One cell of the listing facts grid (canvas B): green icon, bold value, small label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="14dp"
    android:paddingEnd="10dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/factIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        app:tint="@color/color_primary" />

    <TextView
        android:id="@+id/factValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/factLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.PlantMate.Meta"
        android:textSize="12.5sp" />
</LinearLayout>
