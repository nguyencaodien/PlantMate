<?xml version="1.0" encoding="utf-8"?>
<!-- Launch (approved mockup v3 A, 2026-10-15): on the logo's deep green a light ring is drawn, the logo blooms
     inside it with a soft glow, then "PlantMate" closes in from wide spacing and the line under it rises. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <FrameLayout
        android:layout_width="260dp"
        android:layout_height="260dp">

        <View
            android:id="@+id/splash_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_brand_glow" />

        <ImageView
            android:id="@+id/splash_ring"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/avd_brand_ring" />

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/logo_plantmate" />
    </FrameLayout>

    <TextView
        android:id="@+id/splash_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:letterSpacing="-0.02"
        android:text="@string/brand_name"
        android:textAppearance="@style/TextAppearance.PlantMate.Hero"
        android:textColor="@color/brand_on_deep"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/splash_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/splash_tagline"
        android:textAppearance="@style/TextAppearance.PlantMate.Body"
        android:textColor="@color/brand_on_deep_muted"
        android:textSize="15sp" />
</LinearLayout>
