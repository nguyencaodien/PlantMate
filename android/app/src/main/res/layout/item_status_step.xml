<?xml version="1.0" encoding="utf-8"?>
<!-- One step of the hand-over (canvas B): a check and green label once done, then a line to the next step. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/step_icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_check"
        android:visibility="gone" />

    <TextView
        android:id="@+id/step_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PlantMate.Label"
        android:textSize="13sp" />

    <View
        android:id="@+id/step_line"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@color/color_panel_line" />
</LinearLayout>
