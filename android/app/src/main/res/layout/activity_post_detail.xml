<?xml version="1.0" encoding="utf-8"?>
<!-- Community post (Roundtable-inspired): a slim top bar ("POST"), the post in the feed's card
     style, the comments, and a rounded comment bar with a green send button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/postDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_composer"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/postDetailHero"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/postDetailBack"
            style="@style/Widget.PlantMate.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/inbox_back"
            app:backgroundTint="@color/color_surface"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="52dp"
            android:accessibilityHeading="true"
            android:text="@string/post_detail_header"
            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/postDetailShare"
            style="@style/Widget.PlantMate.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@string/community_share_post"
            app:backgroundTint="@color/color_surface"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_share" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/postDetailContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <!-- The post -->
                <LinearLayout
                    android:id="@+id/postDetailCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_stat_tile"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/postDetailAvatar"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_lime_circle"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.PlantMate.Label"
                            android:textColor="@color/color_on_accent"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/postDetailAuthor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.PlantMate.Label"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/postDetailTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/postDetailProfile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_composer_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/community_view_profile"
                            android:textAppearance="@style/TextAppearance.PlantMate.Label"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/postDetailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="2dp"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textColor="@color/color_text_primary"
                        android:textIsSelectable="true"
                        android:textSize="16sp" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/postDetailPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/color_primary_tint"
                        android:contentDescription="@string/community_post_photo"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame16" />

                    <LinearLayout
                        android:id="@+id/postDetailListing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_mint_14"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/postDetailListingName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/postDetailListingMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/postDetailCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_tag_pill"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textAppearance="@style/TextAppearance.PlantMate.Label"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/color_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/postDetailLike"
                            style="@style/Widget.PlantMate.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="-12dp"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/color_text_primary"
                            android:textSize="14sp"
                            app:icon="@drawable/ic_heart_outline"
                            app:iconPadding="6dp"
                            app:iconSize="20dp"
                            app:iconTint="@color/color_like" />

                        <TextView
                            android:id="@+id/postDetailCommentBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.PlantMate.Label"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/ic_chat"
                            app:drawableTint="@color/color_text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/postDetailCommentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/postDetailComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="20dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/postDetailLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/color_success" />

        <LinearLayout
            android:id="@+id/postDetailNotFound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="120dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mam" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/post_detail_not_found"
                android:textAppearance="@style/TextAppearance.PlantMate.CardTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/postDetailRetry"
                style="@style/Widget.PlantMate.Button.Tonal.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/action_retry" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/postDetailError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="120dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mam" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/post_detail_load_error"
                android:textAppearance="@style/TextAppearance.PlantMate.CardTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/postDetailErrorRetry"
                style="@style/Widget.PlantMate.Button.Tonal.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/action_retry" />
        </LinearLayout>
    </FrameLayout>

    <!-- Comment bar -->
    <LinearLayout
        android:id="@+id/postDetailComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/postDetailReplyBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_mint_14"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/postDetailReplying"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.PlantMate.Label"
                android:textColor="@color/color_on_primary_tint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/postDetailCancelReply"
                style="@style/Widget.PlantMate.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/action_cancel" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.PlantMate.TextInputLayout.Search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:boxBackgroundColor="@color/color_background"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/postDetailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/post_detail_comment_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="1000"
                    android:maxLines="4"
                    android:minHeight="48dp"
                    android:minLines="1"
                    android:textAppearance="@style/TextAppearance.PlantMate.Body"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/postDetailSend"
                style="@style/Widget.PlantMate.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/post_detail_send"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/color_primary"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_send"
                app:iconTint="@color/color_on_primary"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
