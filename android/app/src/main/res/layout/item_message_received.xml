<?xml version="1.0" encoding="utf-8"?>
<!-- Received chat message (Bright Green): text bubble, photo, or voice note (play button,
     waveform, duration). The adapter shows the part that matches the message type. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_sm">

    <!-- Plant card: the listing asked about, above the question (canvas B grey panel) -->
    <LinearLayout
        android:id="@+id/message_listing"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_16"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/message_listing_photo"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@color/color_panel_line"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame12" />

        <TextView
            android:id="@+id/message_listing_type"
            style="@style/Widget.PlantMate.Tag"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/message_listing_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/inbox_listing_unavailable"
            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/message_listing_offer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp"
            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_message_received"
        android:maxWidth="272dp"
        android:paddingStart="14dp"
        android:paddingTop="11dp"
        android:paddingEnd="14dp"
        android:paddingBottom="11dp"
        android:textAppearance="@style/TextAppearance.PlantMate.Body"
        android:textColor="@color/color_text_primary" />

    <FrameLayout
        android:id="@+id/message_photo_frame"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_frame_18_mint"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:visibility="gone">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_botanical_placeholder" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/message_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/chat_photo"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame18" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/message_voice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_message_received"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/message_voice_play"
            style="@style/Widget.PlantMate.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/chat_voice_play"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/color_primary"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_play"
            app:iconSize="18dp"
            app:iconTint="@color/color_on_primary"
            app:strokeWidth="0dp" />

        <com.example.ungdungchiasecaycanh.ui.inbox.WaveformView
            android:id="@+id/message_voice_wave"
            android:layout_width="132dp"
            android:layout_height="26dp"
            android:layout_marginStart="10dp" />

        <TextView
            android:id="@+id/message_voice_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textAppearance="@style/TextAppearance.PlantMate.Label"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
