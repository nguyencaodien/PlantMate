<?xml version="1.0" encoding="utf-8"?>
<!-- Blocked member row: initials, name, Unblock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_18"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/blocked_user_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_lime_circle"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.PlantMate.Label"
        android:textColor="#FF0A3622"
        android:textFontWeight="700"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/blocked_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PlantMate.Display"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/blocked_user_unblock"
        style="@style/Widget.PlantMate.Button.Tonal.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/safety_unblock" />
</LinearLayout>
