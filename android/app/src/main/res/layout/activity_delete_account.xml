<?xml version="1.0" encoding="utf-8"?>
<!-- Delete account: what goes, what stays, confirm who you are, then delete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/deleteAccountRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/deleteAccountHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteAccountBack"
            style="@style/Widget.PlantMate.IconButton.Hero"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="-0.02"
            android:text="@string/delete_account_title"
            android:textAppearance="@style/TextAppearance.PlantMate.Hero"
            android:textColor="@color/color_hero_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/delete_account_supporting"
            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
            android:textColor="@color/color_hero_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/delete_account_removed_title"
                android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/delete_account_removed_body"
                android:textAppearance="@style/TextAppearance.PlantMate.Body"
                android:textColor="@color/color_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:text="@string/delete_account_kept_title"
                android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/delete_account_kept_body"
                android:textAppearance="@style/TextAppearance.PlantMate.Body"
                android:textColor="@color/color_text_secondary" />

            <!-- Shown for email accounts: the password confirms it is really them. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/deleteAccountPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="@string/delete_account_password_hint"
                android:visibility="gone"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/deleteAccountPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/deleteAccountMethodNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                android:textSize="14sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/deleteAccountConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/delete_account_confirm"
                android:textAppearance="@style/TextAppearance.PlantMate.Body" />

            <TextView
                android:id="@+id/deleteAccountError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.PlantMate.Body"
                android:textColor="@color/color_danger"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteAccountButton"
                style="@style/Widget.PlantMate.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:enabled="false"
                android:minHeight="52dp"
                android:text="@string/delete_account_action"
                android:textColor="@color/color_danger"
                app:icon="@drawable/ic_trash"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/color_danger" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/deleteAccountProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/color_danger"
                app:trackColor="@color/color_primary_tint" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
