<?xml version="1.0" encoding="utf-8"?>
<!-- Admin comment row: author, time, text and delete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_16"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/adminCommentAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PlantMate.Label"
            android:textColor="@color/color_text_primary"
            android:textFontWeight="700" />

        <TextView
            android:id="@+id/adminCommentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.PlantMate.Body" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/adminCommentDelete"
        style="@style/Widget.PlantMate.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/admin_delete_comment"
        app:icon="@drawable/ic_delete_outline"
        app:iconTint="@color/color_danger"
        app:strokeWidth="0dp" />
</LinearLayout>
