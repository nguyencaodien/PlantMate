<?xml version="1.0" encoding="utf-8"?>
<!-- VNeID demo: shows the intended flow, clearly marked as not connected to the real system. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vneidRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/vneidHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vneidBack"
            style="@style/Widget.PlantMate.IconButton.Hero"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/vneid_title"
            android:textAppearance="@style/TextAppearance.PlantMate.ScreenTitle"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_stat_tile"
        android:backgroundTint="@color/type_trade_soft"
        android:drawablePadding="10dp"
        android:padding="14dp"
        android:text="@string/vneid_demo_banner"
        android:textAppearance="@style/TextAppearance.PlantMate.Label"
        android:textColor="@color/color_text_primary"
        android:textSize="14sp"
        app:drawableStartCompat="@drawable/ic_shield"
        app:drawableTint="@color/type_trade_ink" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_card_20"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_verified" />

        <TextView
            android:id="@+id/vneidStepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.PlantMate.Label"
            android:textColor="@color/color_text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/vneidStepBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.PlantMate.Body"
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/vneidProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/color_success"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vneidAction"
            style="@style/Widget.PlantMate.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp" />
    </LinearLayout>
</LinearLayout>
