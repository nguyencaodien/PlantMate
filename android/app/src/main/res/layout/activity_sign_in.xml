<?xml version="1.0" encoding="utf-8"?>
<!-- Sign in (approved mockup v4 H, 2026-10-15): a deep-green block from the logo, rounded at the bottom, with three
     columns of plant photos drifting slowly (middle up, sides down) under the logo and name; then the usual form (email,
     password with show/hide, forgot password, sign in), Google / Facebook, and register. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sign_in_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- Brand block: runs under the status bar. It starts 36dp above the screen so only its bottom corners show
         (a uniform-radius outline clips the photo columns on every API level). -->
    <FrameLayout
        android:id="@+id/sign_in_panel"
        android:layout_width="match_parent"
        android:layout_height="376dp"
        android:layout_marginTop="-36dp"
        android:background="@drawable/bg_brand_block"
        android:clipToOutline="true"
        android:importantForAccessibility="noHideDescendants">

        <!-- Three columns of plant photos; SignInActivity fills them and drifts them (middle up, sides down). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/sign_in_column_height"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/sign_in_column_1" style="@style/PlantMateSignInColumn" />
            <LinearLayout android:id="@+id/sign_in_column_2" style="@style/PlantMateSignInColumn"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
            <LinearLayout android:id="@+id/sign_in_column_3" style="@style/PlantMateSignInColumn" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/bg_brand_fade_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_brand_fade_bottom" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_plantmate" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="-0.02"
                android:text="@string/brand_name"
                android:textAppearance="@style/TextAppearance.PlantMate.Hero"
                android:textColor="@color/brand_on_deep"
                android:textSize="20sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/sign_in_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="0dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/sign_in_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:letterSpacing="-0.02"
            android:text="@string/action_sign_in"
            android:textAppearance="@style/TextAppearance.PlantMate.Hero"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/sign_in_supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sign_in_welcome_back"
            android:textAppearance="@style/TextAppearance.PlantMate.Body"
            android:textColor="@color/color_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/email_input"
            android:text="@string/label_email"
            android:textAppearance="@style/TextAppearance.PlantMate.Label"
            android:textColor="@color/color_text_primary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/email_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_mail"
            app:startIconTint="@color/color_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/email_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:hint="@string/hint_email"
                android:importantForAutofill="yes"
                android:inputType="textEmailAddress"
                android:minHeight="52dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textAppearance="@style/TextAppearance.PlantMate.Body"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:labelFor="@id/password_input"
            android:text="@string/label_password"
            android:textAppearance="@style/TextAppearance.PlantMate.Label"
            android:textColor="@color/color_text_primary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/password_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:endIconMode="password_toggle"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="@color/color_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/hint_password_rule"
                android:importantForAutofill="yes"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:minHeight="52dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textAppearance="@style/TextAppearance.PlantMate.Body"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/action_forgot_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"
            android:text="@string/sign_in_forgot_password"
            android:textAppearance="@style/TextAppearance.PlantMate.Label"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_sign_in"
            style="@style/Widget.PlantMate.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/action_sign_in" />

        <!-- "or", between two hairlines -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/color_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/sign_in_or"
                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/color_border" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_continue_google"
                style="@style/Widget.PlantMate.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sign_in_google_short"
                app:icon="@drawable/ic_google_logo"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                app:iconTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_continue_facebook"
                style="@style/Widget.PlantMate.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/sign_in_facebook_short"
                android:visibility="gone"
                app:icon="@drawable/ic_facebook_logo"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                app:iconTint="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prompt_new_here"
                android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/action_join_garden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/action_join_garden"
                android:textAppearance="@style/TextAppearance.PlantMate.Label"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
