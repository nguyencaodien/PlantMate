<?xml version="1.0" encoding="utf-8"?>
<!-- One "what did you come for" card (canvas B .choice): round check, title and a short line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_choice"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_choice_check"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:padding="4dp"
        android:src="@drawable/ic_check"
        app:tint="@color/choice_check_tint" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/choice_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/choice_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
