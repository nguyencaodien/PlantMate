<?xml version="1.0" encoding="utf-8"?>
<!-- One condition row on listing detail: label (96dp, grey) and value (semibold). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/factLabel"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.PlantMate.Body"
        android:textColor="@color/color_text_secondary"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/factValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.PlantMate.Tag"
        android:textColor="@color/color_text_primary"
        android:textSize="14.5sp" />
</LinearLayout>
