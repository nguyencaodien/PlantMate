<?xml version="1.0" encoding="utf-8"?>
<!-- Admin list row: photo or initials, title, subtitle, meta and a status pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_18"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:padding="12dp"
    android:stateListAnimator="@animator/pm_press">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <TextView
            android:id="@+id/adminRowInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_lime_circle"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.PlantMate.Label"
            android:textColor="#FF0A3622"
            android:textFontWeight="700"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/adminRowIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_mint_14"
            android:contentDescription="@null"
            android:padding="16dp"
            android:visibility="gone"
            app:tint="@color/color_on_primary_tint" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/adminRowPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame14" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/adminRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle" />

        <TextView
            android:id="@+id/adminRowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/adminRowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.PlantMate.Meta"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/adminRowPill"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_status_active"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textAppearance="@style/TextAppearance.PlantMate.Label"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
