<?xml version="1.0" encoding="utf-8"?>
<!-- Admin: edit or delete any post, delete comments. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminPost"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/adminPostScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/adminPostHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/adminPostBack"
                        style="@style/Widget.PlantMate.IconButton.Hero"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/action_back"
                        app:icon="@drawable/ic_arrow_back" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                </LinearLayout>

                <TextView
                    android:id="@+id/adminPostTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="-0.02"
                    android:textAppearance="@style/TextAppearance.PlantMate.Hero"
                    android:textColor="@color/color_hero_text" />
                <TextView
                    android:id="@+id/adminPostAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                    android:textColor="@color/color_hero_text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="26dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_lime_pill"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:text="@string/admin_badge"
                    android:textAppearance="@style/TextAppearance.PlantMate.Tag"
                    android:textColor="#FF0A3622"
                    app:drawableStartCompat="@drawable/ic_lock"
                    app:drawableTint="#FF0A3622" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/adminPostForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/admin_field_post_text"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/color_text_primary"
                    android:textFontWeight="700" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/adminPostTextLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:hintEnabled="false"
                    app:counterEnabled="true"
                    app:counterMaxLength="2000">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/adminPostText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="150dp"
                        android:gravity="top|start"
                        android:paddingTop="16dp"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="2000"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/admin_field_category"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/color_text_primary"
                    android:textFontWeight="700" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/adminPostCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:chipSpacingHorizontal="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/adminCategoryGeneral"
                            style="@style/PlantMateFilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/post_category_general" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/adminCategorySharing"
                            style="@style/PlantMateFilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/post_category_sharing" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/adminCategoryQuestion"
                            style="@style/PlantMateFilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/post_category_question" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/adminCategoryWin"
                            style="@style/PlantMateFilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/post_category_win" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/adminCategoryTip"
                            style="@style/PlantMateFilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/post_category_tip" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/admin_field_image"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/color_text_primary"
                    android:textFontWeight="700" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_dashed_add">

                    <LinearLayout
                        android:id="@+id/adminPostImageEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_camera_add"
                            app:tint="@color/color_on_primary_tint" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/admin_no_image"
                            android:textAppearance="@style/TextAppearance.PlantMate.Label"
                            android:textColor="@color/color_on_primary_tint" />
                    </LinearLayout>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/adminPostImagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/admin_image_preview"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantMate.Frame18" />
                </FrameLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/adminPostImageLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_camera_add"
                    app:startIconTint="@color/color_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/adminPostImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:hint="@string/admin_image_hint"
                        android:inputType="textUri"
                        android:maxLength="2048"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/admin_image_help"
                    android:textAppearance="@style/TextAppearance.PlantMate.Meta"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/adminPostImageRemove"
                    style="@style/Widget.PlantMate.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="2dp"
                    android:text="@string/admin_remove_image"
                    android:textColor="@color/color_danger"
                    app:icon="@drawable/ic_delete_outline"
                    app:iconTint="@color/color_danger" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/admin_note_label"
                    android:textAppearance="@style/TextAppearance.PlantMate.Label"
                    android:textColor="@color/color_text_primary"
                    android:textFontWeight="700" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/adminPostNoteLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_text"
                    app:startIconTint="@color/color_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/adminPostNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:hint="@string/admin_note_hint"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="500"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.PlantMate.Body"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/adminPostSave"
                    style="@style/Widget.PlantMate.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="22dp"
                    android:text="@string/admin_save"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:iconTint="@color/color_primary_button_icon" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/adminPostDelete"
                    style="@style/Widget.PlantMate.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/admin_delete_post"
                    android:textColor="@color/color_danger"
                    app:icon="@drawable/ic_delete_outline"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:iconTint="@color/color_danger"
                    app:strokeColor="@color/color_danger" />

                <TextView
                    android:id="@+id/adminPostCommentsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/adminPostComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/adminPostLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/color_success" />

    <LinearLayout
        android:id="@+id/adminPostError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_mint_circle">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_refresh"
                app:tint="@color/color_on_primary_tint" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/admin_load_error"
            android:textAppearance="@style/TextAppearance.PlantMate.CardTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminPostRetry"
            style="@style/Widget.PlantMate.Button.Tonal.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/action_retry" />
    </LinearLayout>
</FrameLayout>
