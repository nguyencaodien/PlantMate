<?xml version="1.0" encoding="utf-8"?>
<!-- Home filter sheet (Vivid Green): type, pick-up area, sort and "with photos".
     The apply button shows how many plants match before the sheet closes. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_filters_title"
                android:textAppearance="@style/TextAppearance.PlantMate.SectionTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filtersReset"
                style="@style/Widget.PlantMate.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_filters_reset" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/home_filters_area"
            android:textAppearance="@style/TextAppearance.PlantMate.Label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filtersArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="false"
            app:singleSelection="false" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/filtersPhotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="48dp"
            android:text="@string/home_filters_photos"
            android:textAppearance="@style/TextAppearance.PlantMate.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filtersApply"
            style="@style/Widget.PlantMate.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
